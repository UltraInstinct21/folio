{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "folio",
  "version": "0.1.2",
  "identifier": "app.folio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "folio",
        "width": 1000,
        "height": 720,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
